@theme {
    --font-display: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
}

html {
    scroll-behavior: smooth;
}

.site-mobile-panel {
    animation: site-mobile-panel-in 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.site-mobile-overlay {
    animation: site-mobile-overlay-in 180ms ease-out;
}

@keyframes site-mobile-panel-in {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes site-mobile-overlay-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

.process-step-card {
    opacity: 0;
    transform: translateY(18px);
    transition:
        opacity 450ms ease var(--process-delay, 0ms),
        transform 450ms ease var(--process-delay, 0ms),
        border-color 180ms ease,
        box-shadow 180ms ease;
}

.process-step-card.is-visible {
    opacity: 1;
    transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
