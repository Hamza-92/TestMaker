@theme {
    --font-display: 'Montserrat', ui-sans-serif, system-ui, sans-serif;
}

html {
    scroll-behavior: smooth;
}

.site-mobile-panel {
    animation: site-mobile-panel-in 240ms cubic-bezier(0.22, 1, 0.36, 1);
}

.site-mobile-overlay {
    animation: site-mobile-overlay-in 180ms ease-out;
}

@keyframes site-mobile-panel-in {
    from { opacity: 0; transform: translateX(100%); }
    to { opacity: 1; transform: translateX(0); }
}

@keyframes site-mobile-overlay-in {
    from { opacity: 0; }
    to { opacity: 1; }
}

/* Hero visual: use the image selected for this page. */
main > section:first-of-type > div:nth-child(3) > div:nth-child(2) > div:first-child {
    min-height: 510px;
    overflow: hidden;
    border-radius: 24px;
    background: #dbeafe;
    box-shadow: 0 24px 64px rgba(15, 23, 42, 0.12);
}

main > section:first-of-type > div:nth-child(3) > div:nth-child(2) > div:first-child > * {
    display: none;
}

main > section:first-of-type > div:nth-child(3) > div:nth-child(2) > div:first-child::before {
    position: absolute;
    inset: 0;
    content: '';
    background-image: linear-gradient(180deg, rgba(15, 23, 42, 0.02) 35%, rgba(15, 23, 42, 0.3) 100%), url('https://images.unsplash.com/photo-1501504905252-473c47e087f8?auto=format&fit=crop&fm=jpg&q=86&w=1600');
    background-position: center;
    background-size: cover;
}

#how-it-works .process-step-card {
    min-height: 190px;
    padding: 1.25rem;
}

#how-it-works .process-step-card > span {
    width: 3.25rem;
    height: 3.25rem;
}

#how-it-works .process-step-card h3 {
    margin-top: 0.75rem;
}

#how-it-works .process-step-card p {
    margin-top: 0.5rem;
    line-height: 1.5;
}

.process-step-card {
    opacity: 0;
    transform: translateY(18px);
    transition:
        opacity 450ms ease var(--process-delay, 0ms),
        transform 450ms ease var(--process-delay, 0ms),
        border-color 180ms ease,
        box-shadow 180ms ease;
}

.process-step-card.is-visible {
    opacity: 1;
    transform: translateY(0);
}

@media (max-width: 767px) {
    main > section:first-of-type > div:nth-child(3) > div:nth-child(2) > div:first-child {
        min-height: 320px;
    }
}

@media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }

    *,
    *::before,
    *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
    }
}
